rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function userDoc() { return get(userPath()); }
    function activeUser() { return signedIn() && exists(userPath()) && userDoc().data.active == true; }
    function role() { return userDoc().data.role; }
    function isWarehouse() { return activeUser() && role() in ['warehouse','admin']; }
    function isAdmin() { return activeUser() && role() == 'admin'; }
    function isBranch() { return activeUser() && role() == 'branch'; }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /branches/{branchId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isWarehouse() || (isBranch() && resource.data.branchId == userDoc().data.branchId);
      allow create, update, delete: if false;
    }
    match /stock_movements/{movementId} {
      allow read: if isWarehouse();
      allow write: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /system/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}